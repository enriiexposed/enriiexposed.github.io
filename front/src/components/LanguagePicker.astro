---
import { languages } from '../i18n/ui';
import { switchLocalePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = Astro.url.pathname;

const flags = {
  es: `<svg viewBox="0 0 20 14" class="h-3.5 w-5 overflow-hidden rounded-sm"><rect width="20" height="14" fill="#c60b1e"/><rect y="3.5" width="20" height="7" fill="#ffc400"/></svg>`,
  gb: `<svg viewBox="0 0 20 14" class="h-3.5 w-5 overflow-hidden rounded-sm"><rect width="20" height="14" fill="#012169"/><path d="M0 0 20 14M20 0 0 14" stroke="#fff" stroke-width="2.4"/><path d="M0 0 20 14M20 0 0 14" stroke="#c8102e" stroke-width="1.2"/><path d="M10 0V14M0 7H20" stroke="#fff" stroke-width="4"/><path d="M10 0V14M0 7H20" stroke="#c8102e" stroke-width="2.4"/></svg>`,
};
---

<div class="language-picker relative">
  <button
    type="button"
    class="lang-toggle inline-flex h-[34px] w-[34px] cursor-pointer items-center justify-center rounded-full border border-card-border bg-card"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={languages[lang].name}
  >
    <Fragment set:html={flags[languages[lang].flag]} />
  </button>
  <ul
    class="lang-menu pointer-events-none absolute right-0 top-full mt-2 w-40 origin-top-right -translate-y-1 scale-95 list-none rounded-md border border-card-border bg-card p-1 opacity-0 shadow-lg transition duration-200 ease-out"
    role="listbox"
  >
    {
      Object.entries(languages).map(([code, { name, flag }]) => (
        <li>
          <a
            href={switchLocalePath(path, code as Lang)}
            class="flex items-center gap-2 rounded-sm px-2.5 py-2 text-sm text-fg transition-colors duration-150 hover:bg-card-border/50"
            role="option"
            aria-current={code === lang}
          >
            <Fragment set:html={flags[flag]} />
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.language-picker').forEach((picker) => {
    const toggle = picker.querySelector<HTMLButtonElement>('.lang-toggle');
    const menu = picker.querySelector<HTMLElement>('.lang-menu');
    if (!toggle || !menu) return;

    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.add('pointer-events-none', 'opacity-0', '-translate-y-1', 'scale-95');
      menu.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
    };

    const open = () => {
      toggle.setAttribute('aria-expanded', 'true');
      menu.classList.remove('pointer-events-none', 'opacity-0', '-translate-y-1', 'scale-95');
      menu.classList.add('opacity-100', 'translate-y-0', 'scale-100');
    };

    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? close() : open();
    });

    document.addEventListener('click', (e) => {
      if (!picker.contains(e.target as Node)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>
