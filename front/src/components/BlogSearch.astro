---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  tags: string[];
}

const { lang, tags } = Astro.props;
const t = useTranslations(lang);

const fields = [
  { value: 'title', label: t('blog.search.field.title') },
  { value: 'subtitle', label: t('blog.search.field.subtitle') },
  { value: 'body', label: t('blog.search.field.body') },
];

const closed = 'pointer-events-none opacity-0 -translate-y-1 scale-95';
---

<div id="blog-search" class="mt-8">
  <div class="flex items-center gap-2">
    <div class="relative flex flex-1 items-center rounded-md border border-card-border bg-card">
      <div class="field-picker relative">
        <button
          type="button"
          class="field-toggle flex cursor-pointer items-center gap-1.5 border-r border-card-border px-3 py-2 text-sm text-fg"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="field-label">{fields[0].label}</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <ul
          class={`field-menu absolute left-0 top-full z-10 mt-2 w-40 origin-top-left list-none rounded-md border border-card-border bg-card p-1 shadow-lg transition duration-200 ease-out ${closed}`}
          role="listbox"
        >
          {
            fields.map((field, i) => (
              <li>
                <button
                  type="button"
                  data-field={field.value}
                  class="field-option w-full cursor-pointer rounded-sm px-2.5 py-2 text-left text-sm text-fg transition-colors duration-150 hover:bg-card-border/50"
                  role="option"
                  aria-selected={i === 0}
                >
                  {field.label}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <input
        type="search"
        class="search-input min-w-0 flex-1 bg-transparent px-3 py-2 text-fg outline-none"
        placeholder={t('blog.search.placeholder')}
        aria-label={t('blog.search.placeholder')}
      />
    </div>
    <button
      type="button"
      class="tags-toggle inline-flex h-[38px] w-[38px] shrink-0 cursor-pointer items-center justify-center rounded-md border border-card-border bg-card text-fg transition-colors duration-150 hover:bg-card-border/50"
      aria-expanded="false"
      aria-controls="tags-panel"
      aria-label={t('blog.search.tags')}
      title={t('blog.search.tags')}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3Z"></path>
      </svg>
    </button>
  </div>

  <div
    id="tags-panel"
    class={`tags-panel mt-3 rounded-md border border-card-border bg-card p-4 transition duration-200 ease-out ${closed}`}
    hidden
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="inline-flex overflow-hidden rounded-md border border-card-border text-sm" role="group" aria-label={t('blog.search.tags')}>
        <button type="button" data-mode="any" class="mode-btn cursor-pointer px-3 py-1" aria-pressed="true">{t('blog.search.any')}</button>
        <button type="button" data-mode="all" class="mode-btn cursor-pointer border-l border-card-border px-3 py-1" aria-pressed="false">{t('blog.search.all')}</button>
      </div>
      <button type="button" class="clear-tags cursor-pointer text-sm text-muted transition-colors hover:text-fg">{t('blog.search.clear')}</button>
    </div>
    <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
      {
        tags.map((tag) => (
          <li>
            <button
              type="button"
              data-tag={tag}
              class="tag-chip cursor-pointer rounded-full border border-card-border px-2.5 py-0.5 text-xs text-muted transition-colors duration-150 hover:text-fg"
              aria-pressed="false"
            >
              {tag}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .mode-btn[aria-pressed='true'],
  .tag-chip[aria-pressed='true'] {
    background-image: linear-gradient(to right, var(--timeline-line-start), var(--timeline-line-end));
    color: var(--bg);
    border-color: transparent;
  }
  .field-option[aria-selected='true'] {
    background-color: color-mix(in srgb, var(--card-border) 50%, transparent);
  }
</style>

<script>
  const root = document.getElementById('blog-search');

  if (root) {
    const OPEN = ['opacity-100', 'translate-y-0', 'scale-100'];
    const CLOSED = ['pointer-events-none', 'opacity-0', '-translate-y-1', 'scale-95'];
    const normalize = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

    const fieldPicker = root.querySelector<HTMLElement>('.field-picker')!;
    const fieldToggle = root.querySelector<HTMLButtonElement>('.field-toggle')!;
    const fieldMenu = root.querySelector<HTMLElement>('.field-menu')!;
    const fieldLabel = root.querySelector<HTMLElement>('.field-label')!;
    const fieldOptions = root.querySelectorAll<HTMLButtonElement>('.field-option');
    const input = root.querySelector<HTMLInputElement>('.search-input')!;
    const tagsToggle = root.querySelector<HTMLButtonElement>('.tags-toggle')!;
    const panel = root.querySelector<HTMLElement>('.tags-panel')!;
    const modeBtns = root.querySelectorAll<HTMLButtonElement>('.mode-btn');
    const chips = root.querySelectorAll<HTMLButtonElement>('.tag-chip');
    const clear = root.querySelector<HTMLButtonElement>('.clear-tags')!;
    const posts = document.querySelectorAll<HTMLElement>('[data-post]');
    const empty = document.getElementById('blog-empty');

    let field = 'title';
    let mode: 'any' | 'all' = 'any';
    const selected = new Set<string>();

    const setOpen = (menu: HTMLElement, open: boolean) => {
      menu.classList.remove(...(open ? CLOSED : OPEN));
      menu.classList.add(...(open ? OPEN : CLOSED));
    };

    const apply = () => {
      const q = normalize(input.value.trim());
      let visible = 0;
      posts.forEach((post) => {
        const text = normalize(post.dataset[field] ?? '');
        const postTags: string[] = JSON.parse(post.dataset.tags ?? '[]');
        const matchesText = !q || text.includes(q);
        const chosen = [...selected];
        const matchesTags =
          chosen.length === 0 ||
          (mode === 'any' ? chosen.some((t) => postTags.includes(t)) : chosen.every((t) => postTags.includes(t)));
        const show = matchesText && matchesTags;
        (post.closest('li') ?? post).hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    };

    // Field dropdown
    const closeField = () => {
      fieldToggle.setAttribute('aria-expanded', 'false');
      setOpen(fieldMenu, false);
    };
    fieldToggle.addEventListener('click', () => {
      const open = fieldToggle.getAttribute('aria-expanded') !== 'true';
      fieldToggle.setAttribute('aria-expanded', String(open));
      setOpen(fieldMenu, open);
    });
    fieldOptions.forEach((opt) =>
      opt.addEventListener('click', () => {
        field = opt.dataset.field!;
        fieldLabel.textContent = opt.textContent;
        fieldOptions.forEach((o) => o.setAttribute('aria-selected', String(o === opt)));
        closeField();
        apply();
      })
    );
    document.addEventListener('click', (e) => {
      if (!fieldPicker.contains(e.target as Node)) closeField();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeField();
    });

    // Text search
    input.addEventListener('input', apply);

    // Tags panel
    tagsToggle.addEventListener('click', () => {
      const open = tagsToggle.getAttribute('aria-expanded') !== 'true';
      tagsToggle.setAttribute('aria-expanded', String(open));
      if (open) {
        panel.hidden = false;
        requestAnimationFrame(() => setOpen(panel, true));
      } else {
        setOpen(panel, false);
        panel.addEventListener('transitionend', () => (panel.hidden = tagsToggle.getAttribute('aria-expanded') !== 'true'), { once: true });
      }
    });
    modeBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        mode = btn.dataset.mode as 'any' | 'all';
        modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply();
      })
    );
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const tag = chip.dataset.tag!;
        const on = !selected.has(tag);
        on ? selected.add(tag) : selected.delete(tag);
        chip.setAttribute('aria-pressed', String(on));
        apply();
      })
    );
    clear.addEventListener('click', () => {
      selected.clear();
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      apply();
    });
  }
</script>
