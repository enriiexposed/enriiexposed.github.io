---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="sticky top-0 z-50 border-b border-card-border bg-navbar backdrop-blur">
  <nav class="mx-auto grid max-w-5xl grid-cols-3 items-center px-6 py-3">
    <div></div>
    <div class="flex items-center justify-center gap-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="relative text-sm font-medium text-muted transition-[color,transform] duration-200 after:absolute after:-bottom-1 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:rounded-full after:bg-linear-to-r after:from-accent-start after:to-accent-end after:transition-transform after:duration-300 hover:text-fg hover:after:scale-x-100 active:scale-95"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex justify-end">
      <ThemeToggle />
    </div>
  </nav>
</header>
