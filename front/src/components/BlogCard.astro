---
import type { CollectionEntry } from 'astro:content';
import { formatPubDate, readingTime } from '../utils/readingTime';
import { useTranslations, localePath, type Lang } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'blog'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const { title, subtitle, pubDate, image, tags } = entry.data;
const t = useTranslations(lang);
const slug = entry.id.split('/').slice(1).join('/');
---

<a
  href={localePath(lang, `/blog/${slug}`)}
  class="group block"
  data-post
  data-title={title}
  data-subtitle={subtitle}
  data-body={entry.body}
  data-tags={JSON.stringify(tags)}
>
  <article class="flex overflow-hidden rounded-xl border border-card-border bg-card transition duration-300 group-hover:-translate-y-0.5 group-hover:border-accent-start group-hover:shadow-lg">
    <img src={image} alt="" class="w-32 shrink-0 self-stretch object-cover sm:w-48" />
    <div class="flex flex-1 flex-col p-5">
      <h2 class="bg-linear-to-r from-accent-start to-accent-end bg-clip-text text-xl font-bold text-transparent drop-shadow-[0_0_10px_rgba(94,194,255,0.45)] transition duration-300 group-hover:drop-shadow-[0_0_16px_rgba(255,106,193,0.7)] sm:text-2xl">
        {title}
      </h2>
      <p class="mt-1 text-muted">{subtitle}</p>
      <p class="mt-3 text-sm text-muted">{formatPubDate(pubDate, lang)} · {readingTime(entry.body)} {t('blog.readingTime')}</p>
      <ul class="mt-auto flex list-none flex-wrap justify-end gap-2 p-0 pt-4">
        {tags.map((tag) => <li class="rounded-full border border-card-border px-2.5 py-0.5 text-xs text-muted">{tag}</li>)}
      </ul>
    </div>
  </article>
</a>
