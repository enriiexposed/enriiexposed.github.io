<section id="contact" class="mx-auto max-w-2xl px-6 py-16">
  <h2 class="text-2xl font-bold">Contact</h2>
  <p class="mt-2 text-muted">Let's talk? Write to me and I'll get back to you soon.</p>

  <form class="mt-8 flex flex-col gap-4">
    <div class="flex flex-col gap-1">
      <label for="name" class="text-sm text-muted">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        class="rounded-md border border-card-border bg-card px-4 py-2 text-fg"
      />
    </div>
    <div class="flex flex-col gap-1">
      <label for="email" class="text-sm text-muted">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        class="rounded-md border border-card-border bg-card px-4 py-2 text-fg"
      />
    </div>
    <div class="flex flex-col gap-1">
      <label for="subject" class="text-sm text-muted">Subject</label>
      <input
        id="subject"
        name="subject"
        type="text"
        class="rounded-md border border-card-border bg-card px-4 py-2 text-fg"
      />
    </div>
    <div class="flex flex-col gap-1">
      <label for="message" class="text-sm text-muted">Message</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        class="rounded-md border border-card-border bg-card px-4 py-2 text-fg"
      ></textarea>
    </div>
    <button
      type="submit"
      class="mt-2 self-start rounded-md border border-card-border bg-card px-6 py-2.5 text-sm font-medium text-fg"
    >
      Send
    </button>
  </form>
</section>
