---

<section class="mx-auto grid max-w-5xl gap-10 px-6 py-16 md:grid-cols-2 md:items-center">
  <div>
    <h1 class="text-4xl font-bold">Hi, I'm Enrique</h1>
    <p class="mt-4 text-lg text-muted">
      I build things for the web, from idea to deploy.
    </p>
    <a
      href="#projects"
      class="group relative isolate mt-8 inline-flex items-center overflow-hidden rounded-md border border-card-border px-6 py-2.5 text-sm font-medium text-fg"
    >
      <span class="absolute inset-0 -z-10 origin-left scale-x-0 bg-fg transition-transform duration-300 ease-out group-hover:scale-x-100"></span>
      <span class="transition-colors duration-300 group-hover:text-bg">View projects</span>
    </a>
  </div>

  <div class="relative mx-auto aspect-square w-full max-w-sm">
    <svg
      class="absolute inset-0 -z-10 h-full w-full text-card-border"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
    >
      {
        links.map(([a, b]) => (
          <line
            x1={nodes[a].x}
            y1={nodes[a].y}
            x2={nodes[b].x}
            y2={nodes[b].y}
            stroke="currentColor"
            stroke-width="0.5"
            opacity="0.5"
            vector-effect="non-scaling-stroke"
          />
        ))
      }
    </svg>
    {
      nodes.map((node) => (
        <div
          class="absolute flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 animate-float items-center justify-center rounded-full border border-card-border bg-card p-2 shadow-sm"
          style={`left:${node.x}%; top:${node.y}%; animation-delay:${node.delay};`}
          title={node.name}
        >
          <span class="block h-6 w-6" set:html={icons[node.name]} />
        </div>
      ))
    }
  </div>
</section>
